#class definition
class calculator:
    def add(num1, num2):
        return num1 + num2
    def subtract(num1, num2):
        return num1 - num2
    def multiply(num1, num2):
        return num1 * num2
    def divide(num1, num2):
        if num2 != 0:
            return num1 / num2
        else:
            return "Error: Division by zero is not allowed."

#user input
print("Welcome to the calculator!\n")

num1 = input("Please enter the first number:")
operation = input("Please select an operation(+ - * /):")
num2 = input("Please enter the second number:")

#if statements to perform the selected operation
if operation == "+":
    result = calculator.add(float(num1), float(num2))
    print(num1, " + ", num2, " is: ", result)
elif operation == "-":
    result = calculator.subtract(float(num1), float(num2))
    print(num1, " - ", num2, " is: ", result)
elif operation == "*":
    result = calculator.multiply(float(num1), float(num2))
    print(num1, " x ", num2, " is: ", result)
elif operation == "/":
    result = calculator.divide(float(num1), float(num2))
    print(num1, " / ", num2, " is: ", result)
else:
    print("Invalid operation selected. Please choose from +, -, *, or /.")


# Improved alternative implementation (two lines below the original code)
class Calculator:
    def add(self, a, b):
        return a + b
    def subtract(self, a, b):
        return a - b
    def multiply(self, a, b):
        return a * b
    def divide(self, a, b):
        if b == 0:
            return "Error: Division by zero is not allowed."
        return a / b

def main():
    print("Welcome to the calculator! (Improved)\n")
    try:
        n1 = float(input("Please enter the first number: "))
        op = input("Please select an operation(+ - * /): ").strip()
        n2 = float(input("Please enter the second number: "))
    except ValueError:
        print("Invalid number entered.")
        return

    calc = Calculator()
    if op == "+":
        res = calc.add(n1, n2)
    elif op == "-":
        res = calc.subtract(n1, n2)
    elif op == "*":
        res = calc.multiply(n1, n2)
    elif op == "/":
        res = calc.divide(n1, n2)
    else:
        print("Invalid operation selected. Please choose from +, -, *, or /.")
        return

    print(f"{n1} {op} {n2} = {res}")


if __name__ == "__main__":
    main()
